<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Crear cuenta"
            android:textColor="@color/gris_texto"
            android:textSize="26sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search_card"
            android:hint="Nombre"
            android:inputType="textPersonName|textCapWords"
            android:minHeight="48dp"
            android:padding="14dp"
            android:textColor="@color/gris_texto" />

        <EditText
            android:id="@+id/etApellido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search_card"
            android:hint="Apellido"
            android:inputType="textPersonName|textCapWords"
            android:minHeight="48dp"
            android:padding="14dp"
            android:textColor="@color/gris_texto" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search_card"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress"
            android:minHeight="48dp"
            android:padding="14dp"
            android:textColor="@color/gris_texto" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search_card"
            android:hint="Contraseña (mínimo 6 caracteres)"
            android:inputType="textPassword"
            android:minHeight="48dp"
            android:padding="14dp"
            android:textColor="@color/gris_texto" />

        <CheckBox
            android:id="@+id/cbParental"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="Activar modo parental (soy madre, padre o tutor)"
            android:textColor="@color/gris_texto"
            app:buttonTint="@color/verde_principal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Crear cuenta"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/verde_principal" />

    </LinearLayout>
</ScrollView>